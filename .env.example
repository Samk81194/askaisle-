# ==============================================================================
# ASKAISLE - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# 1. Supabase (Database, Auth & Vector Store)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. AI Models (Claude Haiku for responses & OpenAI for embeddings)
ANTHROPIC_API_KEY=sk-ant-api...
OPENAI_API_KEY=sk-proj-...

# 3. Shopify App Credentials (Shopify Partner Dashboard)
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_APP_URL=https://your-domain.com
SHOPIFY_SCOPES=read_products,read_content

# 4. Stripe (Subscriptions & Webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# 5. App Domain & Security
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=super-secret-jwt-key-for-widget-tokens
